{% doc %}
  @prompt
    CAROUSEL TO SHOW USER GENERATED CONTENT, can you allow videos to be used as well
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-ugc-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    padding: 28px 0;
  }

  .ai-ugc-{{ ai_gen_id }}__inner { width: 100%; }

  .ai-ugc-{{ ai_gen_id }}__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
    padding: 0 4px;
  }

  .ai-ugc-{{ ai_gen_id }}__title {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: clamp(22px, 3vw, 34px);
    line-height: 1.15;
  }

  .ai-ugc-{{ ai_gen_id }}__controls { display: flex; gap: 8px; flex-shrink: 0; }

  .ai-ugc-{{ ai_gen_id }}__control {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 1px solid {{ block.settings.text_color }};
    border-radius: 50%;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    cursor: pointer;
  }

  .ai-ugc-{{ ai_gen_id }}__control:disabled { opacity: 0.45; cursor: not-allowed; }

  .ai-ugc-{{ ai_gen_id }}__control:focus-visible,
  .ai-ugc-{{ ai_gen_id }}__card-link:focus-visible {
    outline: 2px solid {{ block.settings.text_color }};
    outline-offset: 3px;
  }

  .ai-ugc-{{ ai_gen_id }}__track {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: thin;
    padding: 2px 4px 12px;
  }

  .ai-ugc-{{ ai_gen_id }}__card {
    flex: 0 0 calc((100% - 42px) / 4);
    min-width: 0;
    scroll-snap-align: start;
  }

  .ai-ugc-{{ ai_gen_id }}__media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: {{ block.settings.corner_radius }}px;
    background: #f1f1f1;
  }

  .ai-ugc-{{ ai_gen_id }}__media img,
  .ai-ugc-{{ ai_gen_id }}__media svg,
  .ai-ugc-{{ ai_gen_id }}__media video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-ugc-{{ ai_gen_id }}__caption {
    margin: 10px 0 0;
    color: {{ block.settings.text_color }};
    font-size: 14px;
    line-height: 1.4;
  }

  .ai-ugc-{{ ai_gen_id }}__card-link { color: inherit; text-decoration: none; }

  @media screen and (max-width: 749px) {
    .ai-ugc-{{ ai_gen_id }}__card { flex-basis: 72%; }
    .ai-ugc-{{ ai_gen_id }}__header { margin-bottom: 14px; }
    .ai-ugc-{{ ai_gen_id }}__control { width: 38px; height: 38px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-ugc-{{ ai_gen_id }}__track { scroll-behavior: auto; }
  }
{% endstyle %}

<ugc-carousel-{{ ai_gen_id }} class="ai-ugc-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-ugc-{{ ai_gen_id }}__inner">
    <div class="ai-ugc-{{ ai_gen_id }}__header">
      {% if block.settings.heading != blank %}<h2 class="ai-ugc-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</h2>{% endif %}
      <div class="ai-ugc-{{ ai_gen_id }}__controls">
        <button class="ai-ugc-{{ ai_gen_id }}__control" type="button" data-direction="previous" aria-label="Scroll to previous posts"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="m15 18-6-6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        <button class="ai-ugc-{{ ai_gen_id }}__control" type="button" data-direction="next" aria-label="Scroll to next posts"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="m9 18 6-6-6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      </div>
    </div>
    <div class="ai-ugc-{{ ai_gen_id }}__track" role="region" aria-label="User generated content" tabindex="0">
      {% for i in (1..6) %}
        {% liquid
          assign image_key = 'post_' | append: i | append: '_image'
          assign video_key = 'post_' | append: i | append: '_video'
          assign caption_key = 'post_' | append: i | append: '_caption'
          assign link_key = 'post_' | append: i | append: '_link'
          assign post_image = block.settings[image_key]
          assign post_video = block.settings[video_key]
          assign post_caption = block.settings[caption_key]
          assign post_link = block.settings[link_key]
        %}
        <article class="ai-ugc-{{ ai_gen_id }}__card">
          {% if post_link != blank %}<a class="ai-ugc-{{ ai_gen_id }}__card-link" href="{{ post_link }}" aria-label="{% if post_caption != blank %}{{ post_caption | escape }}{% else %}View community post {{ i }}{% endif %}">{% endif %}
            <div class="ai-ugc-{{ ai_gen_id }}__media">
              {% if post_video != blank %}
                {{ post_video | video_tag: controls: true, playsinline: true, preload: 'metadata' }}
              {% elsif post_image != blank %}
                <img src="{{ post_image | image_url: width: 900 }}" alt="{{ post_image.alt | default: post_caption | escape }}" loading="lazy" width="{{ post_image.width }}" height="{{ post_image.height }}">
              {% else %}
                <div class="ai-ugc-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
              {% endif %}
            </div>
            {% if post_caption != blank %}<p class="ai-ugc-{{ ai_gen_id }}__caption">{{ post_caption | escape }}</p>{% endif %}
          {% if post_link != blank %}</a>{% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</ugc-carousel-{{ ai_gen_id }}>

<script>
  (() => {
    const elementName = 'ugc-carousel-{{ ai_gen_id }}';
    if (customElements.get(elementName)) return;
    class UgcCarousel extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('.ai-ugc-{{ ai_gen_id }}__track');
        this.previousButton = this.querySelector('[data-direction="previous"]');
        this.nextButton = this.querySelector('[data-direction="next"]');
        if (!this.track || !this.previousButton || !this.nextButton) return;
        this.onPrevious = () => this.move(-1);
        this.onNext = () => this.move(1);
        this.onScroll = () => this.updateButtons();
        this.previousButton.addEventListener('click', this.onPrevious);
        this.nextButton.addEventListener('click', this.onNext);
        this.track.addEventListener('scroll', this.onScroll, { passive: true });
        this.resizeObserver = new ResizeObserver(() => this.updateButtons());
        this.resizeObserver.observe(this.track);
        this.updateButtons();
      }
      disconnectedCallback() {
        this.previousButton?.removeEventListener('click', this.onPrevious);
        this.nextButton?.removeEventListener('click', this.onNext);
        this.track?.removeEventListener('scroll', this.onScroll);
        this.resizeObserver?.disconnect();
      }
      move(direction) {
        const card = this.track.querySelector('.ai-ugc-{{ ai_gen_id }}__card');
        if (!card) return;
        const gap = parseFloat(getComputedStyle(this.track).columnGap) || 0;
        this.track.scrollBy({ left: direction * (card.getBoundingClientRect().width + gap), behavior: 'smooth' });
      }
      updateButtons() {
        const maxScroll = this.track.scrollWidth - this.track.clientWidth;
        this.previousButton.disabled = this.track.scrollLeft <= 2;
        this.nextButton.disabled = this.track.scrollLeft >= maxScroll - 2;
      }
    }
    customElements.define(elementName, UgcCarousel);
  })();
</script>

